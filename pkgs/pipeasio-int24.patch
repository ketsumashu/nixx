+static inline float
+asio_int24_to_float(const asio_sample_t *source)
+{
+    int32_t value = (int32_t)((uint32_t)source->bytes[0] | ((uint32_t)source->bytes[1] << 8)
+                            | ((uint32_t)source->bytes[2] << 16));
+    if (value & 0x00800000)
+        value |= ~0x00ffffff;
+    return (float)value / 8388608.0f;
+}
+
+static inline void
+float_to_asio_int24(asio_sample_t *destination, float sample)
+{
+    int32_t value;
+    if (sample <= -1.0f)
+        value = -8388608;
+    else if (sample >= 1.0f)
+        value = 8388607;
+    else
+        value = (int32_t)(sample * 8388608.0f);
+    destination->bytes[0] = (uint8_t)value;
+    destination->bytes[1] = (uint8_t)(value >> 8);
+    destination->bytes[2] = (uint8_t)(value >> 16);
+}
+
+static inline void
+float_buffer_to_asio_int24(asio_sample_t *destination, const audio_sample_t *source,
+                           audio_nframes_t nframes)
+{
+    if (!source)
+    {
+        memset(destination, 0, (size_t)nframes * sizeof(*destination));
+        return;
+    }
+    for (audio_nframes_t i = 0; i < nframes; ++i)
+        float_to_asio_int24(&destination[i], source[i]);
+}
